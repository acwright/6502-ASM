000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               .include "../6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc — External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.5
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for user programs
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$05FF   User Variables / BASIC workspace
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active — centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS — interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — set to inhibit clock updates during write
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               
000000r 1               .segment "CODE"
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Bit Rally — a two-ended Kill the Bit for the AC6502 KIM
000000r 1               ; =============================================================================
000000r 1               ;   This is a raw binary image, not a BASIC program.  There is no tokenized
000000r 1               ;   startup stub: the first byte of the file is the first byte of code, and it
000000r 1               ;   lands at $0800 (PROGRAM_START).  Nothing may be placed before Start —
000000r 1               ;   put data after the code, or behind a jump.
000000r 1               ;
000000r 1               ;   Target is the AC6502 KIM.  The Keypad Card overlays $C000-$FFFF, so the
000000r 1               ;   machine boots into the KC Monitor rather than BASIC:
000000r 1               ;     - No video, no sound, no storage, no RTC, no VIA (HW_PRESENT is $10)
000000r 1               ;     - Chrout goes to the serial port; the LCD belongs to the monitor
000000r 1               ;     - The eight LEDs are a write-only 74HC373 latch on the accessory bus
000000r 1               ;     - ESC aborts a running program from anywhere — that needs no code here
000000r 1               ;
000000r 1               ;   Launching:
000000r 1               ;     Keypad   $0800 then UP   calls here; RTS returns to the KC Monitor
000000r 1               ;     Wozmon   0800R           jumps here; nothing to return to
000000r 1               ;
000000r 1               ;   ESC is the way out, and it is unconditional.  KeyIrq catches it before it
000000r 1               ;   reaches the mailbox — from the pad or as an ESC byte over serial — and
000000r 1               ;   JMPs to WarmStart, which does LDX #$FF / TXS and re-enters the monitor
000000r 1               ;   loop.  The interrupted frame is abandoned, so it does not matter how deep
000000r 1               ;   you were, what you had pushed, or how you were launched.  It also means
000000r 1               ;   ESC does not return to your caller: it lands in the KC Monitor, always.
000000r 1               ; =============================================================================
000000r 1               ;   THE GAME
000000r 1               ; =============================================================================
000000r 1               ;   One bit sweeps across the eight LEDs.  Each end of the row is a kill zone
000000r 1               ;   belonging to a player:
000000r 1               ;
000000r 1               ;     LED   7  6  5  4  3  2  1  0
000000r 1               ;           ^                    ^
000000r 1               ;           |                    |
000000r 1               ;        LEFT kills           RIGHT kills
000000r 1               ;        here with ◄          here with ►
000000r 1               ;
000000r 1               ;   A hit is a press made while the bit is standing in that player's zone —
000000r 1               ;   ◄ while the pattern is $80, or ► while it is $01.  Anything else is
000000r 1               ;   ignored: the wrong key, the right key a frame early, the right key in the
000000r 1               ;   other player's zone.  Unlike the original Kill the Bit there is no penalty
000000r 1               ;   for missing; a miss costs only the lap.
000000r 1               ;
000000r 1               ;   Two players, or one taking both ends.  The game never knows how many hands
000000r 1               ;   are on the pad — it only knows which end got hit.
000000r 1               ;
000000r 1               ;   SCORING.  The score is one byte, packed as two nibbles, shown on the LEDs
000000r 1               ;   between rounds:
000000r 1               ;
000000r 1               ;     %1111 1111
000000r 1               ;      ^^^^ ^^^^
000000r 1               ;      left right
000000r 1               ;
000000r 1               ;   First side to $F wins.  A nibble holds 0-15, so the win must be settled
000000r 1               ;   at $F — incrementing a nibble that already reads $F carries into the other
000000r 1               ;   player's score and corrupts it.
000000r 1               ;
000000r 1               ;   ROUND FLOW.
000000r 1               ;     1. COUNTDOWN   the converging pattern below, one step per COUNT_TIME
000000r 1               ;     2. SWEEP       the bit ping-pongs, one step per SWEEP_DELAY, until a hit
000000r 1               ;     3. HIT         the packed score is displayed for SCORE_TIME
000000r 1               ;     4. WIN         at $F, the final score flashes WIN_FLASHES times and the
000000r 1               ;                    game restarts from zero
000000r 1               ;
000000r 1               ;   The score is only on the LEDs during step 3 — while the bit is sweeping,
000000r 1               ;   the display belongs to the bit.  The countdown also runs once at startup,
000000r 1               ;   before the first sweep, so nobody is caught cold.
000000r 1               ;
000000r 1               ;   THE SWEEP ping-pongs.  The bit runs to one end, and the frame it spends in
000000r 1               ;   that kill zone is also the frame it turns around on; it then runs back to
000000r 1               ;   the other end.  Seven steps between the zones, fourteen for a round trip,
000000r 1               ;   so a zone you have just missed is a long way off — and you can watch the
000000r 1               ;   bit coming at you the whole way.
000000r 1               ;
000000r 1               ;   Every round is dealt fresh: a random starting position AND a random
000000r 1               ;   starting direction.  The entropy is the player's own reaction time, since
000000r 1               ;   the KIM has no RTC and no VIA timer to read — a free-running counter
000000r 1               ;   ticked once per frame and sampled at the moment of the hit is enough.  One
000000r 1               ;   sample gives both: bits 0-2 are the position, bit 3 is the direction.
000000r 1               ;
000000r 1               ;   Clamp the starting position inward with POS_MIN / POS_MAX.  A bit that
000000r 1               ;   starts life already standing in a kill zone hands that player a free point
000000r 1               ;   on frame one, before they have even seen where it is.
000000r 1               ;
000000r 1               ;   INPUT comes from the KC Monitor's mailbox, NOT from Chrin — see the
000000r 1               ;   Keypad section below.  The mailbox is one press deep and holds that press
000000r 1               ;   indefinitely, so clear KEY_READY every frame whether it mattered or not.
000000r 1               ;   A press left sitting from three frames ago must not be allowed to score
000000r 1               ;   when the bit finally arrives.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Hardware
000000r 1               ; =============================================================================
000000r 1               
000000r 1               LEDS := $9400                   ; Accessory bus — eight LEDs behind a 74HC373
000000r 1                                               ; latch.  Write-only: a read is open bus.
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Zero page
000000r 1               ; =============================================================================
000000r 1               ;   Not the whole of $3A-$FF, whatever the BIN template says.  That is true of
000000r 1               ;   a machine running nothing underneath you; here the KC Monitor is live and
000000r 1               ;   keeps its own state in the "free" user page:
000000r 1               ;
000000r 1               ;     $00-$39   Kernal
000000r 1               ;     $3A-$3F   yours
000000r 1               ;     $40-$45   KC Monitor — CUR_ADDR, MODE, MON_TMP, KEY_CODE, KEY_READY
000000r 1               ;     $46-$51   KC Monitor — serial Wozmon parser and RX ring indices
000000r 1               ;     $52-$FF   yours
000000r 1               ;
000000r 1               ;   Also live below $0800: $0200 is the monitor's Wozmon line buffer and
000000r 1               ;   $0400-$04FF its serial RX ring.  Neither is in our way at $0800.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Keypad — read the KC Monitor's mailbox, not Chrin
000000r 1               ; =============================================================================
000000r 1               ;   Chrin is not the way in on this machine.  CartReset repoints IRQ_PTR at
000000r 1               ;   the cartridge's own KeyIrq, and KeyIrq never calls WriteBuffer — so the
000000r 1               ;   Kernal ring at $0200 is never fed, and Chrin returns C=0 forever.  Serial
000000r 1               ;   bytes go the same way, into the monitor's own ring at $0400.
000000r 1               ;
000000r 1               ;   KeyIrq latches the keycode into a one-deep mailbox instead:
000000r 1               ;
000000r 1               ;     lda KEY_READY
000000r 1               ;     beq @NoKey
000000r 1               ;     sei                       ; take both bytes without racing KeyIrq
000000r 1               ;     lda KEY_CODE
000000r 1               ;     stz KEY_READY
000000r 1               ;     cli                       ; NEVER leave I set — ESC dies with it
000000r 1               ;
000000r 1               ;   These are the cartridge's own zero-page variables rather than a published
000000r 1               ;   API, and they are still the lesser evil: KeyPoll sits in ROM with no
000000r 1               ;   jump-table entry, so calling it means hardcoding an address that moves on
000000r 1               ;   every firmware build.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               KEY_CODE  := $44                ; Last keycode latched by KeyIrq
000000r 1               KEY_READY := $45                ; Nonzero when a press is waiting
000000r 1               
000000r 1               ; The code is not the value.  These come off the MM74C922 encoder in the order
000000r 1               ; the switches sit on the board — see the keypad map in 6502-DOCS.  ESC ($10)
000000r 1               ; never reaches the mailbox: KeyIrq takes it and jumps to WarmStart.
000000r 1               
000000r 1               KEY_LEFT  = $00                 ; ◄
000000r 1               KEY_RIGHT = $0B                 ; ►
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Scoring
000000r 1               ; =============================================================================
000000r 1               
000000r 1               SCORE_WIN   = $0F               ; First nibble to reach this wins
000000r 1               MASK_LEFT   = %11110000         ; Left player's nibble
000000r 1               MASK_RIGHT  = %00001111         ; Right player's nibble
000000r 1               INC_LEFT    = $10               ; One point in the upper nibble
000000r 1               INC_RIGHT   = $01               ; One point in the lower nibble
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Kill zones
000000r 1               ; =============================================================================
000000r 1               ;   The bit turns around on the same frame it is killable.
000000r 1               
000000r 1               ZONE_LEFT  = %10000000          ; $80 — LED 7, killed with ◄
000000r 1               ZONE_RIGHT = %00000001          ; $01 — LED 0, killed with ►
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Sweep direction
000000r 1               ; =============================================================================
000000r 1               ;   Valued to drop straight out of the frame counter: AND #DIR_MASK gives one
000000r 1               ;   or the other with no further work.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               DIR_MASK  = %00001000           ; Counter bit 3 -> starting direction
000000r 1               DIR_LEFT  = %00000000           ; Travelling toward LED 7 — ASL
000000r 1               DIR_RIGHT = %00001000           ; Travelling toward LED 0 — LSR
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Starting position
000000r 1               ; =============================================================================
000000r 1               
000000r 1               POS_MASK = %00000111            ; Counter bits 0-2 -> position 0-7
000000r 1               POS_MIN  = 1                    ; Clamped inward, so the bit never starts
000000r 1               POS_MAX  = 6                    ; life inside a kill zone
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Timing — all in centiseconds (10 ms units), the SysDelay unit
000000r 1               ; =============================================================================
000000r 1               
000000r 1               SWEEP_DELAY = 8                 ; Per LED step.  The difficulty knob: seven
000000r 1                                               ; steps end to end, so 560 ms between zones
000000r 1               COUNT_TIME  = 40                ; Per countdown step
000000r 1               SCORE_TIME  = 75                ; How long the score sits on the LEDs
000000r 1               WIN_TIME    = 20                ; Per flash phase, on and off
000000r 1               WIN_FLASHES = 6                 ; Flashes before the game restarts
000000r 1               
000000r 1               ; =============================================================================
000000r 1               ;   Start — Program entry point ($0800)
000000r 1               ; =============================================================================
000000r 1               Start:
000000r 1  A9 00          lda #0
000002r 1  8D rr rr       sta Score
000005r 1               
000005r 1               ; =============================================================================
000005r 1               ;   Do Round — The entry point for each round
000005r 1               ; =============================================================================
000005r 1               
000005r 1               DoRound:
000005r 1  20 rr rr       jsr CountdownDisplay          ; Show the countdown when the round begins
000008r 1  20 rr rr       jsr SweepInit                 ; Start the sweep; When we fall out a hit has occurred...
00000Br 1               
00000Br 1  AD rr rr       lda Score
00000Er 1  29 F0          and #MASK_LEFT                ; Mask out the upper nibble
000010r 1  4A             lsr
000011r 1  4A             lsr
000012r 1  4A             lsr
000013r 1  4A             lsr                           ; and shift it right four bits
000014r 1  C9 0F          cmp #SCORE_WIN                ; Did left player win?
000016r 1  F0 0F          beq @DoRoundWinner            ; if so show win
000018r 1               
000018r 1  AD rr rr       lda Score
00001Br 1  29 0F          and #MASK_RIGHT               ; Mask out the lower nibble
00001Dr 1  C9 0F          cmp #SCORE_WIN                ; Did right player win?
00001Fr 1  F0 06          beq @DoRoundWinner            ; if so show win
000021r 1               
000021r 1  20 rr rr       jsr ScoreDisplay              ; ...otherwise show the score
000024r 1  4C rr rr       jmp DoRound                   ; and play the next round
000027r 1               @DoRoundWinner:
000027r 1  20 rr rr       jsr WinDisplay                ; Display the winner
00002Ar 1  4C rr rr       jmp Start                     ; Restart
00002Dr 1               
00002Dr 1               ; =============================================================================
00002Dr 1               ;   Check Input — Latch and clear the mailbox, once per frame
00002Dr 1               ; =============================================================================
00002Dr 1               ;   Must run every frame regardless of outcome — see the INPUT note up top.
00002Dr 1               ;   LastKey is left at $FF ("no key") on a miss; no keycode off the MM74C922
00002Dr 1               ;   can ever collide with that, so CheckHit can trust it below.
00002Dr 1               
00002Dr 1               CheckInput:
00002Dr 1  A5 45          lda KEY_READY
00002Fr 1  F0 09          beq @CheckInputIsZero         ; No key; fall out of check
000031r 1  A5 44          lda KEY_CODE                  ; otherwise get the key code
000033r 1  8D rr rr       sta LastKey                   ; and store it
000036r 1  64 45          stz KEY_READY                 ; Clear key ready
000038r 1  80 05          bra @CheckInputDone           ; and exit
00003Ar 1               @CheckInputIsZero:
00003Ar 1  A9 FF          lda #$FF                      ; $FF sentinel — no real keycode reaches this
00003Cr 1  8D rr rr       sta LastKey                   ; far, so it can't be mistaken for a press
00003Fr 1               @CheckInputDone:
00003Fr 1  60             rts
000040r 1               
000040r 1               ; =============================================================================
000040r 1               ;   Check Hit — Score a hit if SweepVal's zone matches LastKey
000040r 1               ; =============================================================================
000040r 1               ;   Must run before SweepVal is stepped below — this is checking whether the
000040r 1               ;   value that was just shown and delayed on (still in SweepVal) was killed,
000040r 1               ;   not the value the bit is about to move to next.
000040r 1               
000040r 1               CheckHit:
000040r 1  A9 00          lda #0
000042r 1  8D rr rr       sta Hit                       ; Clear Hit — stale non-zero here would end
000045r 1                                               ; every future sweep on frame one
000045r 1  AD rr rr       lda SweepVal
000048r 1  C9 80          cmp #ZONE_LEFT                ; Are we in the left kill zone?
00004Ar 1  F0 06          beq @CheckHitLeft             ; Continue to the left hit check
00004Cr 1  C9 01          cmp #ZONE_RIGHT               ; Are we in the right kill zone?
00004Er 1  F0 0B          beq @CheckHitRight            ; Continue to the right hit check
000050r 1  80 30          bra @CheckHitDone             ; otherwise fall out of check
000052r 1               
000052r 1               @CheckHitLeft:
000052r 1  AD rr rr       lda LastKey                   ; Load the last key press
000055r 1  C9 00          cmp #KEY_LEFT                 ; Is it the left key?
000057r 1  F0 0B          beq @CheckHitDoHitLeft        ; if so record the hit
000059r 1  80 27          bra @CheckHitDone             ; if not, exit
00005Br 1               
00005Br 1               @CheckHitRight:
00005Br 1  AD rr rr       lda LastKey                   ; Load the last key press
00005Er 1  C9 0B          cmp #KEY_RIGHT                ; Is it the right key?
000060r 1  F0 12          beq @CheckHitDoHitRight       ; if so record the hit
000062r 1  80 1E          bra @CheckHitDone             ; if not, exit
000064r 1               
000064r 1               @CheckHitDoHitLeft:
000064r 1  A9 01          lda #1
000066r 1  8D rr rr       sta Hit                       ; Store the hit
000069r 1  AD rr rr       lda Score
00006Cr 1  18             clc
00006Dr 1  69 10          adc #INC_LEFT                 ; Increment the player left score
00006Fr 1  8D rr rr       sta Score
000072r 1  80 0E          bra @CheckHitDone             ; Exit
000074r 1               
000074r 1               @CheckHitDoHitRight:
000074r 1  A9 01          lda #1
000076r 1  8D rr rr       sta Hit                       ; Store the hit
000079r 1  AD rr rr       lda Score
00007Cr 1  18             clc
00007Dr 1  69 01          adc #INC_RIGHT                ; Increment the player right score
00007Fr 1  8D rr rr       sta Score                     ; Falls through to @CheckHitDone
000082r 1               
000082r 1               @CheckHitDone:
000082r 1  60             rts
000083r 1               
000083r 1               ; =============================================================================
000083r 1               ;   Sweep Init — The sweep init routine
000083r 1               ; =============================================================================
000083r 1               
000083r 1               SweepInit:
000083r 1  AD rr rr       lda Counter                   ; Load the last counter value
000086r 1  29 08          and #DIR_MASK                 ; and get the direction
000088r 1  8D rr rr       sta SweepDir
00008Br 1               
00008Br 1  AD rr rr       lda Counter                   ; Load the last counter value again
00008Er 1  29 07          and #POS_MASK                 ; and get the possible starting position (0-7)
000090r 1               
000090r 1  C9 01          cmp #POS_MIN
000092r 1  B0 02          bcs @SweepPosNotBelow         ; If A >= POS_MIN, skip to next check
000094r 1  A9 01          lda #POS_MIN                  ; otherwise clamp to POS_MIN
000096r 1               @SweepPosNotBelow:
000096r 1  C9 06          cmp #POS_MAX
000098r 1  90 02          bcc @SweepPosClamped          ; If A < POS_MAX, we are good
00009Ar 1  A9 06          lda #POS_MAX                  ; otherwise clamp to POS_MAX
00009Cr 1               @SweepPosClamped:
00009Cr 1  AA             tax                           ; X = clamped position, 1-6
00009Dr 1               
00009Dr 1  A9 01          lda #1                        ; build the one-hot pattern, starting at bit 0
00009Fr 1               @SweepPosShift:
00009Fr 1  E0 00          cpx #0
0000A1r 1  F0 04          beq @SweepPosShiftDone
0000A3r 1  0A             asl                           ; walk the lit bit up to the starting position
0000A4r 1  CA             dex
0000A5r 1  80 F8          bra @SweepPosShift
0000A7r 1               @SweepPosShiftDone:
0000A7r 1  8D rr rr       sta SweepVal                  ; store the one-hot starting position
0000AAr 1               
0000AAr 1               ; =============================================================================
0000AAr 1               ;   Sweep Display — The sweep display loop
0000AAr 1               ; =============================================================================
0000AAr 1               
0000AAr 1               SweepDisplay:
0000AAr 1  EE rr rr       inc Counter                   ; Free-running; also reseeds next round's SweepInit
0000ADr 1               
0000ADr 1  AD rr rr       lda SweepVal                  ; Show the bit at its current position
0000B0r 1  8D 00 94       sta LEDS
0000B3r 1  20 rr rr       jsr SweepDelay
0000B6r 1  20 rr rr       jsr CheckInput                ; Latch this frame's key press, or $FF
0000B9r 1  20 rr rr       jsr CheckHit                  ; Score against the position just shown above —
0000BCr 1                                               ; both must run before SweepVal moves below
0000BCr 1  AD rr rr       lda Hit
0000BFr 1  D0 2D          bne @SweepDisplayDone         ; A hit ends the sweep
0000C1r 1               
0000C1r 1  AD rr rr       lda SweepDir
0000C4r 1  C9 00          cmp #DIR_LEFT
0000C6r 1  F0 02          beq @SweepLeft                ; DIR_LEFT  -> walking toward LED 7, step with ASL
0000C8r 1  80 0D          bra @SweepRight               ; DIR_RIGHT -> walking toward LED 0, step with LSR
0000CAr 1               
0000CAr 1               @SweepLeft:
0000CAr 1  AD rr rr       lda SweepVal                  ; Reload — SweepDir was in A for the check above
0000CDr 1  0A             asl                           ; One step toward LED 7
0000CEr 1  8D rr rr       sta SweepVal
0000D1r 1  C9 80          cmp #ZONE_LEFT                ; Landed in the left kill zone?
0000D3r 1  F0 0F          beq @SweepReverse
0000D5r 1  80 D3          bra SweepDisplay
0000D7r 1               
0000D7r 1               @SweepRight:
0000D7r 1  AD rr rr       lda SweepVal                  ; Reload — SweepDir was in A for the check above
0000DAr 1  4A             lsr                           ; One step toward LED 0
0000DBr 1  8D rr rr       sta SweepVal
0000DEr 1  C9 01          cmp #ZONE_RIGHT               ; Landed in the right kill zone?
0000E0r 1  F0 02          beq @SweepReverse
0000E2r 1  80 C6          bra SweepDisplay
0000E4r 1               
0000E4r 1               @SweepReverse:
0000E4r 1  AD rr rr       lda SweepDir
0000E7r 1  49 08          eor #DIR_MASK                 ; Flip toward the opposite wall
0000E9r 1  8D rr rr       sta SweepDir
0000ECr 1  80 BC          bra SweepDisplay              ; The bit still shows in the zone on the next pass
0000EEr 1               
0000EEr 1               @SweepDisplayDone:              ; Reached only when CheckHit sets Hit, above
0000EEr 1  60             rts                           ; Unwinds through SweepInit's fallthrough, back to DoRound
0000EFr 1               
0000EFr 1               ; =============================================================================
0000EFr 1               ;   Sweep Delay - The sweep delay subroutine
0000EFr 1               ; =============================================================================
0000EFr 1               
0000EFr 1               SweepDelay:
0000EFr 1  5A             phy                           ; SysDelay clobbers Y so lets save it...
0000F0r 1  A9 08          lda #SWEEP_DELAY
0000F2r 1  A2 00          ldx #0
0000F4r 1  20 75 A0       jsr SysDelay                  ; Delay for SWEEP_DELAY centiseconds
0000F7r 1  7A             ply                           ; and restore it
0000F8r 1  60             rts
0000F9r 1               
0000F9r 1               ; =============================================================================
0000F9r 1               ;   Countdown Display — The countdown display loop
0000F9r 1               ; =============================================================================
0000F9r 1               
0000F9r 1               CountdownDisplay:
0000F9r 1  A9 00          lda #0
0000FBr 1  8D 00 94       sta LEDS                      ; Clear the LEDs
0000FEr 1  A0 00          ldy #0
000100r 1               @CountdownDisplayLoop:
000100r 1  20 rr rr       jsr CountdownDelay
000103r 1  B9 rr rr       lda Countdown,y               ; Load the next byte from the countdown data
000106r 1  8D 00 94       sta LEDS
000109r 1  C8             iny
00010Ar 1  98             tya
00010Br 1  C9 04          cmp #COUNTDOWN_LEN
00010Dr 1  D0 F1          bne @CountdownDisplayLoop
00010Fr 1               @CountdownDisplayExit:
00010Fr 1  20 rr rr       jsr CountdownDelay
000112r 1  A9 FF          lda #$FF                      ; Light all the LEDs
000114r 1  8D 00 94       sta LEDS
000117r 1  60             rts
000118r 1               
000118r 1               ; =============================================================================
000118r 1               ;   Countdown Delay - The countdown delay subroutine
000118r 1               ; =============================================================================
000118r 1               
000118r 1               CountdownDelay:
000118r 1  5A             phy                           ; SysDelay clobbers Y so lets save it...
000119r 1  A9 28          lda #COUNT_TIME
00011Br 1  A2 00          ldx #0
00011Dr 1  20 75 A0       jsr SysDelay                  ; Delay for COUNT_TIME centiseconds
000120r 1  7A             ply                           ; and restore it
000121r 1  60             rts
000122r 1               
000122r 1               ; =============================================================================
000122r 1               ;   Score Display — The score display routine
000122r 1               ; =============================================================================
000122r 1               
000122r 1               ScoreDisplay:
000122r 1  AD rr rr       lda Score
000125r 1  8D 00 94       sta LEDS
000128r 1  20 rr rr       jsr ScoreDelay
00012Br 1  60             rts
00012Cr 1               
00012Cr 1               ; =============================================================================
00012Cr 1               ;   Score Delay - The score delay subroutine
00012Cr 1               ; =============================================================================
00012Cr 1               
00012Cr 1               ScoreDelay:
00012Cr 1  5A             phy                           ; SysDelay clobbers Y so lets save it...
00012Dr 1  A9 4B          lda #SCORE_TIME
00012Fr 1  A2 00          ldx #0
000131r 1  20 75 A0       jsr SysDelay                  ; Delay for SCORE_TIME centiseconds
000134r 1  7A             ply                           ; and restore it
000135r 1  60             rts
000136r 1               
000136r 1               ; =============================================================================
000136r 1               ;   Win Display — The win display routine
000136r 1               ; =============================================================================
000136r 1               
000136r 1               WinDisplay:
000136r 1  A0 06          ldy #WIN_FLASHES
000138r 1               @WinDisplayLoop:
000138r 1  AD rr rr       lda Score
00013Br 1  8D 00 94       sta LEDS
00013Er 1  20 rr rr       jsr WinDelay
000141r 1  A9 00          lda #0
000143r 1  8D 00 94       sta LEDS
000146r 1  20 rr rr       jsr WinDelay
000149r 1  88             dey
00014Ar 1  98             tya
00014Br 1  D0 EB          bne @WinDisplayLoop
00014Dr 1               @WinDisplayExit:
00014Dr 1  60             rts
00014Er 1               
00014Er 1               ; =============================================================================
00014Er 1               ;   Win Delay - The win delay subroutine
00014Er 1               ; =============================================================================
00014Er 1               
00014Er 1               WinDelay:
00014Er 1  5A             phy                           ; SysDelay clobbers Y so lets save it...
00014Fr 1  A9 14          lda #WIN_TIME
000151r 1  A2 00          ldx #0
000153r 1  20 75 A0       jsr SysDelay                  ; Delay for WIN_TIME centiseconds
000156r 1  7A             ply                           ; and restore it
000157r 1  60             rts
000158r 1               
000158r 1               ; =============================================================================
000158r 1               ;   Data
000158r 1               ; =============================================================================
000158r 1               
000158r 1  00           Score:    .byte 0               ; The players score; Upper nibble player left - Lower nibble player right
000159r 1  00           Counter:  .byte 0               ; The sweep counter
00015Ar 1  00           SweepVal: .byte 0               ; Current sweep value
00015Br 1  00           SweepDir: .byte 0               ; Current sweep direction
00015Cr 1  FF           LastKey:  .byte $FF             ; Latched by CheckInput each frame; $FF means no key
00015Dr 1  00           Hit:      .byte 0               ; Set by CheckHit; cleared at the top of every call
00015Er 1               
00015Er 1               ; The countdown: two lit LEDs walking in from the ends until they meet.
00015Er 1               ; Four steps of COUNT_TIME, then the sweep starts.
00015Er 1               ;
00015Er 1               ;   $81  %10000001
00015Er 1               ;   $42  %01000010
00015Er 1               ;   $24  %00100100
00015Er 1               ;   $18  %00011000
00015Er 1               
00015Er 1               Countdown:
00015Er 1  81 42 24 18    .byte $81, $42, $24, $18
000162r 1               COUNTDOWN_LEN = * - Countdown
000162r 1               
